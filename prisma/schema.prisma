generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  user_id           String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model user {
  user_id    String   @id @default(cuid())
  fullname   String
  email      String   @unique
  password   String
  role       String   @default("wisatawan")
  created_at DateTime @default(now())

  accounts               Account[]
  guesthouse_transaction guesthouse_transaction[]
}

model kuisioner_guesthouse {
  kuisioner_id     String    @id @default(cuid())
  fullname         String
  age              Int?
  number_of_people Int?
  contact          String?
  country          String?
  country_flag     String?
  date_of_stay     DateTime?
  date_of_checkout DateTime?
  passport         String?
  booking_at       String?

  guesthouse    guesthouse? @relation(fields: [guesthouse_id], references: [guesthouse_id])
  guesthouse_id String?
}

model guesthouse {
  guesthouse_id          String   @id @default(cuid())
  guesthouse_name        String
  guesthouse_images      String[]
  guesthouse_location    String
  guesthouse_description String
  guesthouse_map_url     String

  price Int @default(800000)

  kuisioner_guesthouse   kuisioner_guesthouse[]
  review_guesthouse      review_guesthouse[]
  guesthouse_transaction guesthouse_transaction[]
}

model guesthouse_transaction {
  guesthouse_transaction_id Int @id @default(autoincrement())

  created_at     DateTime @default(now())
  total_price    Int
  quantity       Int
  payment_method String

  status      status_order
  code        String
  invoice_url String

  guesthouse_id String?
  user_id       String?

  guesthouse guesthouse? @relation(fields: [guesthouse_id], references: [guesthouse_id])
  user       user?       @relation(fields: [user_id], references: [user_id])
}

enum status_order {
  pending
  success
  failed
}

model review_guesthouse {
  review_id    String  @id @default(cuid())
  impression   String
  rating       Int
  review_image String?

  guesthouse    guesthouse? @relation(fields: [guesthouse_id], references: [guesthouse_id])
  guesthouse_id String?
}
